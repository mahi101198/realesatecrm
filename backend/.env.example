# Environment Configuration Example
# Copy to .env for local development. Never commit real credentials.

APP_NAME="Real Estate CRM Backend"
APP_ENV="development" # development, test, staging, production
DEBUG=true
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Supabase Auth & Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-placeholder"

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# API Prefix
API_V1_PREFIX="/api/v1"

# Rate Limiting Foundation
RATE_LIMIT_PER_MINUTE=60
PUBLIC_INTAKE_RATE_LIMIT_PER_MINUTE=5

# Public intake proxy trust (only True behind a proxy that strips inbound X-Forwarded-For)
TRUST_PROXY_HEADERS=false

# Public base URL this app is reachable at (used to build webhook callback URLs)
APP_PUBLIC_BASE_URL="http://localhost:8000"

# Superfone Telephony Integration
SUPERFONE_SFVOPI_API_KEY="your-sfvopi-api-key-placeholder"
SUPERFONE_SFVOPI_BASE_URL="https://prod-api.superfone.co.in/superfone/sfvopi/"
SUPERFONE_SFVOPI_FROM_NUMBER="+91XXXXXXXXXX"
SUPERFONE_CRM_API_KEY="your-crm-api-key-placeholder"
SUPERFONE_CRM_BASE_URL="https://prod-api.superfone.co.in/superfone/api/"
SUPERFONE_WEBHOOK_SHARED_SECRET="generate-a-long-random-secret"
# The CRM event-notification bearer secret is no longer a single global
# value -- it's per-tenant now (superfone_crm_tenant_configs, migration 033),
# set via PUT /tenants/{tenant_id}/superfone-crm-config, not an env var.

# Voice agent media stream. Superfone's SFVoPI answer webhook returns Stream
# JSON pointing here, then opens a bidirectional WebSocket carrying the live
# PSTN leg as raw PCMA/8kHz frames. app/voice/router.py now implements a
# compatible endpoint inside this app, so point this at ourselves:
#   wss://<your-public-host>/api/v1/voice/stream
# (any external bridge that speaks the same protocol still works instead).
VOICE_AGENT_STREAM_URL="wss://your-public-host/api/v1/voice/stream?token=SAME-VALUE-AS-SUPERFONE_WEBHOOK_SHARED_SECRET"
VOICE_AGENT_STREAM_CODEC="PCMA"
VOICE_AGENT_STREAM_SAMPLE_RATE=8000

# LiveKit — the media plane the AI voice agent joins. This does NOT replace
# Superfone: Superfone keeps dialling the PSTN leg and keeps streaming its
# audio to VOICE_AGENT_STREAM_URL above. app/voice/ bridges that stream into a
# LiveKit room (one room per call attempt) and puts an AI agent in that room.
# Leave LIVEKIT_URL / keys empty to disable the voice layer completely: calls
# are still placed, still tracked, still retried — they just have no AI agent
# on them. VOICE_AGENT_ENABLED is the independent kill-switch.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key-placeholder"
LIVEKIT_API_SECRET="your-livekit-api-secret-placeholder"
VOICE_AGENT_ENABLED=true

# LiveKit Inference Gateway — the models the voice agent listens, thinks and
# speaks with. Authenticated with the LIVEKIT_API_KEY/SECRET pair above, so
# there is no extra credential here, only model selection. Note the voice agent
# reasons through VOICE_LLM_MODEL via LiveKit Inference, NOT through the direct
# Gemini API: WhatsApp and the lead orchestrator stay on GEMINI_MODEL below via
# app/agents/llm.py, the two are independent seams.
# Leave any of these empty to leave that provider unregistered — the call is
# still placed and tracked by Superfone, it just carries no AI.
VOICE_LLM_MODEL="provider/your-llm-model-placeholder"
VOICE_STT_MODEL="provider/your-stt-model-placeholder"
VOICE_STT_LANGUAGE="multi"
VOICE_TTS_MODEL="provider/your-tts-model-placeholder"
VOICE_TTS_VOICE_ID="your-tts-voice-id-placeholder"
VOICE_TTS_LANGUAGE="hi"

# Gemini AI Orchestration (LangGraph lead workflow + WhatsApp agent)
# Leave GEMINI_API_KEY empty to disable the AI layer completely: inbound
# WhatsApp messages are still resolved, stored and instrumented, just never
# auto-answered. GEMINI_MODEL is the single knob for cost/latency tuning.
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_MAX_TOKENS=2048
AI_ORCHESTRATOR_ENABLED=true

# WhatsApp (Superfone "Dragonfly") webhook -- reuses SUPERFONE_CRM_API_KEY /
# SUPERFONE_CRM_BASE_URL for outbound sends (same superfone/api/ base path);
# separate secret for the webhook token since it's a distinct registered URL.
SUPERFONE_WHATSAPP_WEBHOOK_SHARED_SECRET="generate-a-long-random-secret"

# Direct-Meta WhatsApp Cloud API (per-tenant credentials, whatsapp_tenant_configs)
# Required before any tenant WhatsApp credentials can be stored or used --
# app/integrations/whatsapp/crypto.py fails closed if empty. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY="generate-a-fernet-key-see-comment-above"

# Bearer secret the whatsapp_busness_dashboard product (a separate,
# unmodified repository) sends on POST /webhooks/whatsapp-dashboard/call-agent;
# configured there as its CALL_AGENT_API_KEY environment variable.
WHATSAPP_DASHBOARD_CALL_AGENT_BEARER_SECRET="generate-a-long-random-secret"
